        "chapterId": "ch01",
        "partId": "p1"
      },
      "aliases": [
        "rate"
      ]
    },
    {
      "term": "simple interest",
      "definition": "interest paid only on the original principal",
      "introducedIn": {
        "chapterId": "ch01",
        "partId": "p1"
      },
      "aliases": []
    },
    {
