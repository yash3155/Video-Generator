{
  "chapterId": "ch13",
  "partId": "p1",
  "formulas": [
    {
      "id": "M01",
      "latex": "S_u = S_0 u, \\quad S_d = S_0 d \\quad (u > 1, d < 1)",
      "description": "Stock Price Evolution"
    },
    {
      "id": "M02",
      "latex": "\\Delta = \\frac{c_u - c_d}{S_0 u - S_0 d}",
      "description": "Hedge Ratio Delta"
    },
    {
      "id": "M03",
      "latex": "p = \\frac{e^{r \\Delta t} - d}{u - d}",
      "description": "Risk-Neutral Probability"
    },
    {
      "id": "M04",
      "latex": "c = e^{-r \\Delta t} [p c_u + (1 - p) c_d]",
      "description": "One-Step Call Option Value"
    },
    {
      "id": "M05",
      "latex": "u = e^{\\sigma \\sqrt{\\Delta t}}, \\quad d = e^{-\\sigma \\sqrt{\\Delta t}} = \\frac{1}{u}",
      "description": "CRR Volatility Calibration"
    }
  ]
}