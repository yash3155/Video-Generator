  "terms": [
    {
      "term": "Forward Rate Agreement",
      "fullForm": "FRA",
      "definition": "An OTC contract locking the interest rate to be paid or received over a future period on a specified principal.",
      "factId": "F01"
    },
    {
      "term": "Macaulay duration",
      "definition": "The weighted average maturity of a bond's cash flows, measuring interest rate sensitivity.",
      "factId": "F04"
    },
    {
      "term": "Modified duration",
      "definition": "Macaulay duration divided by one plus yield per period, measuring percentage price change per unit yield shift.",
      "factId": "F05"
    },
    {
      "term": "convexity",
      "definition": "The rate of change of duration with respect to yield, measuring curvature in bond price-yield relationships.",
      "factId": "F06"
    },
    {
      "term": "Liquidity Preference Theory",
      "definition": "Theory stating forward rates exceed expected future zero rates due to risk premiums demanded by lenders for longer maturities.",
      "factId": "F07"
    },
    {
      "term": "Expectations Theory",
      "definition": "Theory stating long-term rates reflect expected future short-term rates without term premiums.",
      "factId": "F12"
    }
  ],
