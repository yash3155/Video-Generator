  "formulas": [
    {
      "id": "M01",
      "latex": "c = S_0 N(d_1) - K e^{-rT} N(d_2)",
      "description": "BSM European Call Formula"
    },
    {
      "id": "M02",
      "latex": "p = K e^{-rT} N(-d_2) - S_0 N(-d_1)",
      "description": "BSM European Put Formula"
    },
    {
      "id": "M03",
      "latex": "d_1 = \\frac{\\ln(S_0 / K) + (r + 0.5\\sigma^2)T}{\\sigma \\sqrt{T}}, \\quad d_2 = d_1 - \\sigma \\sqrt{T}",
      "description": "Normalized Standard Normal Offsets"
    },
    {
      "id": "M04",
      "latex": "\\sigma_{n+1} = \\sigma_n - \\frac{c_{\\text{BSM}}(\\sigma_n) - c_{\\text{market}}}{\\mathcal{V}(\\sigma_n)}",
      "description": "Newton-Raphson Implied Volatility Solver"
    }
  ]
