{
  "bookId": "hull",
  "chapterId": "ch06",
  "partId": "p2",
  "formulas": [
    {
      "id": "M01",
      "name": "Eurodollar Tick Value",
      "latex": "\\text{Tick Value} = \\$1,000,000 \\times 0.0001 \\times \\frac{90}{360} = \\$25",
      "variables": [
        {
          "symbol": "Principal",
          "description": "Standard notional principal",
          "unit": "currency"
        },
        {
          "symbol": "Tick",
          "description": "One basis point change (0.01%)",
          "unit": "decimal"
        },
        {
          "symbol": "Tenor",
          "description": "3-month interest period (90/360)",
          "unit": "years"
        }
      ]
    },
    {
      "id": "M02",
      "name": "Convexity Adjustment",
      "latex": "\\text{Forward Rate} = \\text{Futures Rate} - \\frac{1}{2} \\sigma^2 T_1 T_2",
      "variables": [
        {
          "symbol": "sigma",
          "description": "Annualized interest rate change volatility",
          "unit": "decimal/year"
        },
        {
          "symbol": "T_1",
          "description": "Time to contract maturity",
          "unit": "years"
        },
        {
          "symbol": "T_2",
          "description": "Maturity of underlying rate (T_1 + 0.25)",
          "unit": "years"
        }
      ]
    },
    {
      "id": "M03",
      "name": "Duration-Based Hedge Ratio",
      "latex": "N^* = \\frac{P \\cdot D_P}{F_C \\cdot D_F}",
      "variables": [
        {
          "symbol": "N^*",
          "description": "Optimal number of futures contracts to trade",
          "unit": "contracts"
        },
        {
          "symbol": "P",
          "description": "Market value of bond portfolio being hedged",
          "unit": "currency"
        },
        {
          "symbol": "D_P",
          "description": "Modified duration of bond portfolio",
          "unit": "years"
        },
        {
          "symbol": "F_C",
          "description": "Dollar contract price of futures contract",
          "unit": "currency"
        },
        {
          "symbol": "D_F",
          "description": "Modified duration of CTD bond underlying futures",
          "unit": "years"
        }
      ]
    }
  ]
}