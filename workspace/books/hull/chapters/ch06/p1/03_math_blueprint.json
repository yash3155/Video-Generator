{
  "bookId": "hull",
  "chapterId": "ch06",
  "partId": "p1",
  "formulas": [
    {
      "id": "M01",
      "name": "Cash Price (Dirty Price)",
      "latex": "\\text{Cash Price} = \\text{Quoted Clean Price} + \\text{Accrued Interest}",
      "variables": [
        {
          "symbol": "Cash Price",
          "description": "Actual invoice cash paid per $100 face value",
          "unit": "currency"
        },
        {
          "symbol": "Quoted Price",
          "description": "Clean screen price without accrued coupon",
          "unit": "currency"
        },
        {
          "symbol": "Accrued Interest",
          "description": "Interest earned during current coupon period",
          "unit": "currency"
        }
      ]
    },
    {
      "id": "M02",
      "name": "Futures Invoice Price",
      "latex": "\\text{Invoice Price} = (\\text{Futures Price} \\times \\text{CF}) + \\text{Accrued Interest}",
      "variables": [
        {
          "symbol": "Futures Price",
          "description": "Most recent CBOT settlement price",
          "unit": "currency"
        },
        {
          "symbol": "CF",
          "description": "Conversion Factor based on 6% YTM baseline",
          "unit": "dimensionless"
        },
        {
          "symbol": "Accrued Interest",
          "description": "Interest accrued to physical delivery date",
          "unit": "currency"
        }
      ]
    },
    {
      "id": "M03",
      "name": "Cheapest-to-Deliver Net Cost",
      "latex": "\\text{Net Cost} = \\text{Quoted Cash Price} - (\\text{Futures Price} \\times \\text{CF})",
      "variables": [
        {
          "symbol": "Net Cost",
          "description": "Dollar cost incurred by short seller upon delivery",
          "unit": "currency"
        }
      ]
    },
    {
      "id": "M04",
      "name": "Theoretical Futures Fair Value",
      "latex": "F_0 = \\frac{1}{\\text{CF}} \\left[ (S_0 - I) e^{rT} - A_T \\right]",
      "variables": [
        {
          "symbol": "F_0",
          "description": "Theoretical clean futures price",
          "unit": "currency"
        },
        {
          "symbol": "S_0",
          "description": "Spot cash price of CTD bond",
          "unit": "currency"
        },
        {
          "symbol": "I",
          "description": "Present value of intermediate coupons",
          "unit": "currency"
        },
        {
          "symbol": "A_T",
          "description": "Accrued interest at delivery date T",
          "unit": "currency"
        }
      ]
    }
  ]
}