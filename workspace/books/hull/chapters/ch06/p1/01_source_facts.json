  "terms": [
    {
      "term": "day count convention",
      "definition": "Rule counting calendar days to compute accrued interest fractions.",
      "factId": "F01"
    },
    {
      "term": "accrued interest",
      "definition": "Coupon interest earned since the last payment date and owed to the bond seller.",
      "factId": "F02"
    },
    {
      "term": "clean price",
      "definition": "Quoted bond price excluding accrued interest.",
      "factId": "F02"
    },
    {
      "term": "dirty price",
      "definition": "Actual cash price paid by the buyer including accrued interest.",
      "factId": "F02"
    },
    {
      "term": "Conversion Factor",
      "fullForm": "CF",
      "definition": "Theoretical clean bond price per dollar face value discounted at 6.0% yield.",
      "factId": "F04"
    },
    {
      "term": "Invoice Price",
      "definition": "Total delivery cash equal to settlement price times conversion factor plus accrued interest.",
      "factId": "F05"
    },
    {
      "term": "Cheapest-to-Deliver",
      "fullForm": "CTD",
      "definition": "Eligible Treasury bond minimizing delivery cost to the short seller.",
      "factId": "F06"
    },
    {
      "term": "Wild Card play",
      "definition": "Option allowing shorts between 2:00 PM and 8:00 PM to deliver at locked 2:00 PM settlement.",
      "factId": "F08"
    }
  ],
