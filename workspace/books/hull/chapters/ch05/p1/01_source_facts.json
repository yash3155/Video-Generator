    {
      "id": "F09",
      "category": "numerical_example",
      "statement": "Consider a 1-year forward on a non-dividend stock trading at $100 with r = 5.0%. Theoretical forward price is $100 * exp(0.05 * 1) = $105.13. If the market quote is $108.00, cash-and-carry arbitrage locks in $2.87 riskless profit.",
      "citation": {
        "chapter": "5",
        "section": "5.2",
        "page": "106"
      },
      "numbers": {
        "inputs": [
          {
            "symbol": "S0",
            "label": "Spot stock price",
            "value": 100,
            "unit": "dollars"
          },
          {
            "symbol": "r",
            "label": "Risk-free rate",
            "value": 0.05,
            "unit": "per year"
          },
          {
            "symbol": "T",
            "label": "Horizon",
            "value": 1,
            "unit": "years"
          },
          {
            "symbol": "F_mkt",
            "label": "Observed market forward quote",
            "value": 108,
            "unit": "dollars"
          }
        ],
        "steps": [
          {
            "label": "Fair theoretical forward price",
            "expr": "100 * exp(0.05 * 1)",
            "value": 105.13
          },
          {
            "label": "Arbitrage profit per share",
            "expr": "108 - 105.13",
            "value": 2.87
          }
        ],
        "result": {
          "symbol": "profit",
          "label": "Riskless cash-and-carry profit",
          "value": 2.87,
          "unit": "dollars"
        },
        "rounding": 2
      }
    },
    {
      "id": "F10",
      "category": "numerical_example",
      "statement": "Consider a 1-year forward on a dividend-paying stock with spot price S0 = $60.00, dividend present value I = $2.00, and continuous risk-free rate r = 5.0%. Subtracting dividends gives $58.00, and fair forward price is $58.00 * exp(0.05 * 1) = $60.97.",
      "citation": {
        "chapter": "5",
        "section": "5.3",
        "page": "109"
      },
      "numbers": {
        "inputs": [
          {
            "symbol": "S0",
            "label": "Spot stock price",
            "value": 60,
            "unit": "dollars"
          },
          {
            "symbol": "I",
            "label": "Present value of dividends",
            "value": 2,
            "unit": "dollars"
          },
          {
            "symbol": "r",
            "label": "Continuous risk-free rate",
            "value": 0.05,
            "unit": "per year"
          },
          {
            "symbol": "T",
            "label": "Time to delivery",
            "value": 1,
            "unit": "years"
          }
        ],
        "steps": [
          {
            "label": "Dividend-adjusted spot price",
            "expr": "60 - 2",
            "value": 58
          },
          {
            "label": "Continuous compounding factor",
            "expr": "exp(0.05 * 1)",
            "value": 1.0513
          },
          {
            "label": "Fair forward price",
            "expr": "(60 - 2) * exp(0.05 * 1)",
            "value": 60.97
          }
        ],
        "result": {
          "symbol": "F0",
          "label": "Fair 1-year forward price",
          "value": 60.97,
          "unit": "dollars"
        },
        "rounding": 2
      }
    },
    {
      "id": "F11",
      "category": "claim",
      "statement": "When interest rates are constant or deterministic, theoretical forward and futures prices are equal. Daily marking to market creates slight differences only when asset prices correlate significantly with interest rates.",
      "citation": {
        "chapter": "5",
        "section": "5.8",
        "page": "118"
      }
    }
  ],
  "realWorldProblem": {
    "actors": "Institutional derivatives desks, equity arbitrageurs, and corporate hedging officers",
