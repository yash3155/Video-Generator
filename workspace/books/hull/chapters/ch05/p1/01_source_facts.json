{
  "bookId": "hull",
  "chapterId": "ch05",
  "partId": "p1",
  "facts": [
    {
      "id": "F01",
      "category": "definition",
      "statement": "An investment asset is an asset held for investment purposes by significant numbers of investors (such as gold, silver, stocks, and bonds). Two-sided arbitrage enforces exact forward price parity.",
      "citation": {
        "chapter": "5",
        "section": "5.1",
        "page": "103"
      }
    },
    {
      "id": "F02",
      "category": "definition",
      "statement": "A consumption asset is held primarily for manufacturing or physical consumption (such as crude oil, copper, and corn). Because physical short selling is impractical, arbitrage enforces only an upper price bound.",
      "citation": {
        "chapter": "5",
        "section": "5.1",
        "page": "103"
      }
    },
    {
      "id": "F03",
      "category": "formula",
      "statement": "For an investment asset providing no intermediate income, the forward price is F0 = S0 * exp(r * T), where S0 is spot price, r is the continuous risk-free rate, and T is time to maturity in years.",
      "citation": {
        "chapter": "5",
        "section": "5.2",
        "page": "105"
      },
      "formula": {
        "id": "f_fwd_no_income",
        "latex": "F_0 = S_0 e^{rT}",
        "expression": "S0 * exp(r * T)",
        "solvesFor": "F0",
        "variables": [
          {
            "symbol": "F0",
            "latex": "F_0",
            "meaning": "Theoretical forward price today",
            "unit": "dollars"
          },
          {
            "symbol": "S0",
            "latex": "S_0",
            "meaning": "Spot price of the asset today",
            "unit": "dollars"
          },
          {
            "symbol": "r",
            "latex": "r",
            "meaning": "Continuously compounded risk-free rate",
            "unit": "per year"
          },
          {
            "symbol": "T",
            "latex": "T",
            "meaning": "Time to forward delivery",
            "unit": "years"
          }
        ]
      }
    },
    {
      "id": "F04",
      "category": "definition",
      "statement": "Cash-and-carry arbitrage occurs when F0 > S0 * exp(r * T): the trader borrows S0 at rate r, buys the spot asset, and shorts the forward contract to lock in riskless profit F0 - S0 * exp(r * T).",
      "citation": {
        "chapter": "5",
        "section": "5.2",
        "page": "106"
      }
    },
    {
      "id": "F05",
      "category": "definition",
      "statement": "Reverse cash-and-carry arbitrage occurs when F0 < S0 * exp(r * T): the trader short sells the spot asset, passes intermediate dividends to the lender, invests proceeds at rate r, and buys the forward contract.",
      "citation": {
        "chapter": "5",
        "section": "5.2",
        "page": "107"
      }
    },
    {
      "id": "F06",
      "category": "formula",
      "statement": "For an investment asset providing known cash income with present value I, the forward price is F0 = (S0 - I) * exp(r * T).",
