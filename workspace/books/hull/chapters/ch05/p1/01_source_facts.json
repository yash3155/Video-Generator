    {
      "id": "F07",
      "category": "formula",
      "statement": "For an investment asset paying a continuous dividend yield q, the forward price is F0 = S0 * exp((r - q) * T). When q exceeds r, the forward trades below spot.",
      "citation": {
        "chapter": "5",
        "section": "5.4",
        "page": "111"
      },
      "formula": {
        "id": "f_fwd_yield",
        "latex": "F_0 = S_0 e^{(r - q)T}",
        "expression": "S0 * exp((r - q) * T)",
        "solvesFor": "F0",
