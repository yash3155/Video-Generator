  "terms": [
    {
      "term": "investment asset",
      "definition": "An asset held primarily for investment by many investors, enabling two-sided arbitrage.",
      "factId": "F01"
    },
    {
      "term": "consumption asset",
      "definition": "An asset held for manufacturing or consumption, enforcing only an upper forward bound.",
      "factId": "F02"
    },
    {
      "term": "short selling",
      "definition": "Borrowing securities from a custodian to sell today and returning equivalent shares later.",
      "factId": "F05"
    },
    {
      "term": "cash-and-carry arbitrage",
      "definition": "Borrowing cash, buying spot, and shorting an overpriced forward for riskless profit.",
      "factId": "F04"
    },
    {
      "term": "reverse cash-and-carry",
      "definition": "Shorting spot, lending proceeds at r, and buying an underpriced forward.",
      "factId": "F05"
    },
    {
      "term": "continuous dividend yield",
      "definition": "Annualized dividend rate expressed as a smooth continuous yield q.",
      "factId": "F07"
    },
    {
      "term": "delivery price",
      "definition": "The fixed contractual delivery price K locked when a forward is initiated.",
      "factId": "F08"
    },
    {
      "term": "contract value",
      "definition": "The current mark-to-market worth f of an existing forward contract.",
      "factId": "F08"
    }
  ],
