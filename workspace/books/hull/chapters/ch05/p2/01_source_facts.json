        "chapter": "5",
        "section": "5.12",
        "page": "125"
      },
      "formula": {
        "id": "f_cost_carry",
        "latex": "F_0 = S_0 e^{cT}",
        "expression": "S0 * exp(c * T)",
        "solvesFor": "F0",
