    {
      "id": "F02",
      "category": "definition",
      "statement": "Index arbitrage trades index futures against baskets of 500 constituent shares via program trading once mispricings exceed the transaction-cost arbitrage band. Quarterly unwinds trigger Triple Witching Hour volume surges.",
      "citation": {
        "chapter": "5",
        "section": "5.4",
        "page": "112"
      }
    },
    {
      "id": "F03",
      "category": "formula",
      "statement": "Covered Interest Parity states that currency forward exchange rates satisfy F0 = S0 * exp((r - rf) * T), where S0 is domestic per foreign unit, r is domestic rate, and rf is foreign risk-free rate.",
      "citation": {
        "chapter": "5",
        "section": "5.7",
        "page": "116"
      },
      "formula": {
        "id": "f_fx_cip",
        "latex": "F_0 = S_0 e^{(r - r_f)T}",
        "expression": "S0 * exp((r - rf) * T)",
        "solvesFor": "F0",
        "variables": [
