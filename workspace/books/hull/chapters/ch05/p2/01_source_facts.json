    {
      "id": "F01",
      "category": "formula",
      "statement": "Stock index futures are priced using continuous dividend yield q: F0 = S0 * exp((r - q) * T), where q is the annualized dividend yield on the constituent stock basket.",
      "citation": {
        "chapter": "5",
        "section": "5.4",
        "page": "111"
      },
      "formula": {
        "id": "f_idx_fut",
        "latex": "F_0 = S_0 e^{(r - q)T}",
        "expression": "S0 * exp((r - q) * T)",
        "solvesFor": "F0",
        "variables": [
          {
            "symbol": "F0",
