    {
      "id": "F04",
      "category": "definition",
      "statement": "Covered interest arbitrage exploits deviations from parity by borrowing one currency, converting spot, investing at the foreign rate, and locking forward conversion for riskless profit.",
      "citation": {
        "chapter": "5",
        "section": "5.7",
        "page": "117"
      }
    },
    {
      "id": "F05",
      "category": "formula",
      "statement": "For investment commodities with continuous storage cost rate u, futures follow F0 = S0 * exp((r + u) * T). Storage acts like a negative dividend yield.",
      "citation": {
        "chapter": "5",
        "section": "5.10",
        "page": "121"
      },
      "formula": {
        "id": "f_inv_comm",
        "latex": "F_0 = S_0 e^{(r + u)T}",
        "expression": "S0 * exp((r + u) * T)",
