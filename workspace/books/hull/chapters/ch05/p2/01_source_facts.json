  "terms": [
    {
      "term": "index arbitrage",
      "definition": "Simultaneous trading of stock index futures and constituent equity baskets to capture spread.",
      "factId": "F02"
    },
    {
      "term": "program trading",
      "definition": "Automated computer routing executing orders across hundreds of constituent shares instantaneously.",
      "factId": "F02"
    },
    {
      "term": "arbitrage band",
      "definition": "Transaction-cost corridor around fair value within which arbitrage is unprofitable.",
      "factId": "F02"
    },
    {
      "term": "Covered Interest Parity",
      "fullForm": "CIP",
      "definition": "No-arbitrage FX theorem equating forward exchange premiums to interest rate differentials.",
      "factId": "F03"
    },
    {
      "term": "covered interest arbitrage",
      "definition": "Borrowing low-carry currency, investing in foreign bills, and selling proceeds forward.",
      "factId": "F04"
    },
    {
      "term": "storage costs",
      "definition": "Warehousing and insurance outlays u that lift investment metal futures prices.",
      "factId": "F05"
    },
    {
      "term": "convenience yield",
      "definition": "Non-monetary benefit y of holding physical commodity inventory for operational continuity.",
      "factId": "F06"
    },
    {
      "term": "cost of carry",
      "definition": "Net holding rate c combining financing interest, storage costs, and income yields.",
      "factId": "F07"
    },
    {
      "term": "contango",
      "definition": "Upward-sloping futures curve regime where futures prices trade above spot.",
      "factId": "F08"
    },
    {
      "term": "delivery options",
      "definition": "Short-party privileges covering delivery timing, warehouse location, and asset grade.",
      "factId": "F08"
    }
  ],
