{
  "name": "openlectern",
  "version": "0.1.0",
  "description": "Open-source engine that turns a book you have the right to use into narrated, animated, QA-gated lesson videos.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "openlectern": "bin/openlectern.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/openlectern.mjs start",
    "postinstall": "node scripts/postinstall.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "preflight": "node bin/openlectern.mjs part:preflight",
    "schemas:export": "node bin/openlectern.mjs schemas:export",
    "demo:ci": "node bin/openlectern.mjs start --non-interactive --book demo --chapter ch01 --part p1 --lang en --llm replay --tts mock --draft",
    "verify:phase": "node scripts/verify/phase.mjs",
    "verify:status": "node scripts/verify/status.mjs",
    "verify:done": "node scripts/verify/done.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.11.0",
    "@clack/prompts": "1.9.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@google/genai": "3.6.1",
    "@remotion/bundler": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "commander": "15.1.0",
    "dotenv": "18.0.10",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "jszip": "3.10.2",
    "katex": "0.19.1",
    "mammoth": "1.13.0",
    "mathjs": "15.2.0",
    "node-edge-tts": "1.2.12",
    "pdfjs-dist": "6.5.438",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "ffmpeg-static@5.3.0": true
  }
}
