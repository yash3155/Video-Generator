{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bookId": {
      "type": "string",
      "minLength": 1
    },
    "chapterId": {
      "type": "string",
      "minLength": 1
    },
    "partId": {
      "type": "string",
      "minLength": 1
    },
    "languages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "scenesRendered": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "release": {
      "type": "object",
      "properties": {
        "releasable": {
          "type": "boolean"
        },
        "draft": {
          "type": "boolean"
        },
        "mock": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "releasable",
        "draft",
        "mock",
        "reason"
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "BLOCKER": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "HIGH": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "MEDIUM": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "LOW": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "BLOCKER",
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "layer": {
            "type": "string",
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "L4",
              "L5",
              "L6",
              "Q"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "skipped"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "layer",
          "status"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "BLOCKER",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "layer": {
            "type": "string",
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "L4",
              "L5",
              "L6",
              "Q"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "cause": {
            "type": "string",
            "minLength": 1
          },
          "repair": {
            "type": "string",
            "minLength": 1
          },
          "lang": {
            "type": "string"
          },
          "sceneId": {
            "type": "string"
          },
          "beatId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "layer",
          "message",
          "cause",
          "repair"
        ]
      }
    }
  },
  "required": [
    "bookId",
    "chapterId",
    "partId",
    "languages",
    "generatedAt",
    "release",
    "summary",
    "checks",
    "findings"
  ]
}
