{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "languages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenes": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "beats": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^s\\d{2}b\\d{1,2}$"
                },
                "speaker": {
                  "type": "string",
                  "enum": [
                    "novice",
                    "mentor",
                    "narrator"
                  ]
                },
                "narration": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "display": {
                        "type": "string",
                        "minLength": 1
                      },
                      "spoken": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "display"
                    ]
                  }
                },
                "onScreenIntent": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceFactIds": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "newTerms": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "pauseAfterMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "transition": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "speaker",
                "narration",
                "onScreenIntent"
              ]
            }
          }
        },
        "required": [
          "index",
          "title",
          "purpose",
          "beats"
        ]
      }
    }
  },
  "required": [
    "languages",
    "scenes"
  ]
}
