{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scenes": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "template": {
            "type": "string",
            "enum": [
              "chat_story",
              "tug_of_war",
              "progressive_cards",
              "split_comparison",
              "formula_breakdown",
              "causal_chain",
              "diagram_flow",
              "data_chart",
              "stat_counter",
              "table_compare",
              "concept_clarification",
              "worked_example",
              "interactive_quiz",
              "summary_thread",
              "roadmap",
              "composite_layout"
            ]
          },
          "justification": {
            "type": "string",
            "minLength": 1
          },
          "pedagogicalContinuation": {
            "default": false,
            "type": "boolean"
          },
          "beats": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "visualIntent": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "visualIntent"
              ]
            }
          }
        },
        "required": [
          "index",
          "template",
          "justification",
          "beats"
        ]
      }
    }
  },
  "required": [
    "scenes"
  ]
}
