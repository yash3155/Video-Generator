{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "CONDITIONAL_PASS",
        "FAIL"
      ]
    },
    "factCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "categories": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "formulasCompiled": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "numbersRecomputed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "BLOCKER",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "factId": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "code",
          "message"
        ]
      }
    }
  },
  "required": [
    "status",
    "factCount",
    "categories",
    "formulasCompiled",
    "numbersRecomputed",
    "issues"
  ]
}
