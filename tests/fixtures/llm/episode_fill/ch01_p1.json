    {
      "index": 11,
      "title": "Eight rules to remember",
      "takeaways": [],
      "data": {
        "title": "Simple and compound interest in 8 rules",
        "rules": [
          {
            "id": "r1",
            "title": "Interest is a price",
            "text": "Interest is the price a borrower pays for using someone else's money."
          },
          {
            "id": "r2",
            "title": "Principal",
            "text": "The principal is the amount you lend or deposit at the start."
          },
          {
            "id": "r3",
            "title": "Rate as a decimal",
            "text": "Write the yearly rate as a decimal: 5% becomes 0.05."
          },
          {
            "id": "r4",
            "title": "Simple interest",
            "text": "Simple interest is paid only on the principal: I = P × r × t."
          },
          {
            "id": "r5",
            "title": "Compound interest",
            "text": "Compounding adds each year's interest to the balance, so interest earns interest."
          },
          {
            "id": "r6",
            "title": "Multiply by (1 + r)",
            "text": "Each year multiplies a compound balance by the same factor, 1 + r."
          },
          {
            "id": "r7",
            "title": "Time matters",
            "text": "Over a few years the methods look similar; over decades the gap becomes very large."
          },
          {
            "id": "r8",
            "title": "Only invested money compounds",
            "text": "Compounding works only for money actually invested at the assumed rate, year after year."
          }
        ]
      },
