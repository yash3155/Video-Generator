      "beatOutlines": [
        {
          "beatIndex": 0,
          "textOutline": "Raju asks: Sharma ji, how do all 25 chapters interconnect into one hedge?",
          "sourceFactIds": [
            "fact-evol-01",
            "fact-evol-02"
          ]
        },
        {
          "beatIndex": 1,
          "textOutline": "In 1848, Chicago farmers signed bilateral forward contracts with merchants.",
          "sourceFactIds": [
            "fact-evol-01",
            "fact-evol-02"
          ]
        },
        {
          "beatIndex": 2,
          "textOutline": "When bumper harvest crashed prices by 50%, buyers defaulted, bankrupting farmers!",
          "sourceFactIds": [
            "fact-evol-01",
            "fact-evol-02"
          ]
        },
        {
          "beatIndex": 3,
          "textOutline": "To fix credit defaults, CBOT invented standardized clearinghouse futures.",
          "sourceFactIds": [
            "fact-evol-01",
            "fact-evol-02"
          ]
        }
      ]
    },
    {
      "sceneIndex": 1,
      "title": "Linear Commitments vs Asymmetric Contingent Claims",
      "template": "tug_of_war",
      "concept": "Linear Commitments vs Asymmetric Contingent Claims",
