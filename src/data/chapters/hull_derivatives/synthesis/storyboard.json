      "beatOutlines": [
        {
          "beatIndex": 0,
          "textOutline": "Let us review the eight foundational principles uniting John C. Hull's entire book.",
          "sourceFactIds": [
            "fact-evol-01",
            "fact-evol-02"
          ]
        },
        {
          "beatIndex": 1,
          "textOutline": "Rules 1 & 2: Clearinghouse novation removes credit risk; forwards follow cost-of-carry.",
          "sourceFactIds": [
            "fact-evol-01",
            "fact-evol-02"
          ]
        },
        {
          "beatIndex": 2,
          "textOutline": "Rules 3 & 4: Futures forfeit upside; options grant asymmetric tail protection.",
          "sourceFactIds": [
            "fact-evol-01",
            "fact-evol-02"
          ]
        },
        {
          "beatIndex": 3,
          "textOutline": "Rules 5 & 6: Delta hedging removes drift mu; Greeks prevent gamma wipeouts.",
          "sourceFactIds": [
            "fact-evol-01",
            "fact-evol-02"
          ]
        },
        {
          "beatIndex": 4,
          "textOutline": "Rules 7 & 8: Constant volatility is a myth; volatility smile prices real fat tails.",
          "sourceFactIds": [
            "fact-evol-01",
            "fact-evol-02"
          ]
        },
        {
          "beatIndex": 5,
          "textOutline": "These eight rules unite into an unbreakable risk management framework.",
          "sourceFactIds": [
            "fact-evol-01",
            "fact-evol-02"
          ]
        }
