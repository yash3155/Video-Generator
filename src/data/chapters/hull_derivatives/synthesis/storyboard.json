        "fact-evol-01",
        "fact-evol-02",
        "fact-evol-03"
      ],
      "beatOutlines": [
        {
          "beatIndex": 0,
          "textOutline": "Linear futures lock forward prices with zero premium, but forfeit all favorable upside.",
          "sourceFactIds": [
            "fact-evol-01",
            "fact-evol-02"
          ]
        },
        {
          "beatIndex": 1,
          "textOutline": "Non-linear options demand a premium, but keep upside unlimited while strictly capping loss.",
          "sourceFactIds": [
            "fact-evol-01",
            "fact-evol-02"
          ]
        },
        {
          "beatIndex": 2,
          "textOutline": "Master hedgers combine linear futures for low cost with options for tail-risk survival.",
          "sourceFactIds": [
            "fact-evol-01",
            "fact-evol-02"
          ]
        }
      ]
    },
