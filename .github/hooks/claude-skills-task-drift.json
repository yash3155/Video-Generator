{
  "version": 1,
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "powershell": "$body = [Console]::In.ReadToEnd(); try { Invoke-WebRequest -UseBasicParsing -Uri 'http://127.0.0.1:4895/hook/task-drift?agent=copilot&cwd=c%3A%5CUsers%5CYashAggarwal%5COneDrive%20-%207N%20A%20S%5CDesktop%5Cstudy%20video' -Method POST -Headers @{ 'Content-Type' = 'application/json' } -Body $body | Out-Null } catch { }",
        "timeoutSec": 8
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "powershell": "$body = [Console]::In.ReadToEnd(); try { Invoke-WebRequest -UseBasicParsing -Uri 'http://127.0.0.1:4895/hook/task-drift?agent=copilot&cwd=c%3A%5CUsers%5CYashAggarwal%5COneDrive%20-%207N%20A%20S%5CDesktop%5Cstudy%20video' -Method POST -Headers @{ 'Content-Type' = 'application/json' } -Body $body | Out-Null } catch { }",
        "timeoutSec": 8
      }
    ]
  }
}
