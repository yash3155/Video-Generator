# Google Gemini / free-gemini-api proxy configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Default Model: Gemini 4 Argon
GEMINI_MODEL=gemini-4-argon

# Optional proxy endpoint for free-gemini-api (https://github.com/kodelyx/free-gemini-api.git)
# Local proxy example: http://localhost:8000/v1
# If not using proxy, leave blank or comment out to use standard Gemini endpoints
GEMINI_BASE_URL=

# Reasoning level for gemini-4-argon: low, medium, high
GEMINI_THINKING_LEVEL=medium
