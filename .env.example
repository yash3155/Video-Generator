# OpenLectern configuration. Copy to .env and fill in only what you use. Every key is optional.
# The default path needs no keys: Agent-as-LLM hand-off for text, Edge TTS for voice.

# --- LLM providers (pick one with `--llm <provider>` or in the wizard) ---
# OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, Together, LM Studio, vLLM, Ollama /v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# Local Ollama (native API)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=

# --- TTS providers ---
# Edge TTS needs no key (unofficial online endpoint). Piper runs offline:
PIPER_BINARY=
PIPER_VOICES_DIR=
# Paid voices
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=

# --- Optional tools ---
# Set to 1 when your coding agent exposes NotebookLM MCP tools.
OPENLECTERN_NOTEBOOKLM_MCP=
# Override the folder that holds workspace/ and out/ (default: current directory).
OPENLECTERN_HOME=
