        "title": "Eight reader commandments",
        "takeaways": [
          "Understand interest, principal, compounding, and patience",
          "Differentiate APR from APY and use Rule of 72 for quick estimates",
          "Always evaluate financial gains in terms of real returns after inflation"
        ],
        "data": {
          "title": "8 Reader Commandments: Money That Grows",
          "rules": [
            {
              "id": "r1",
              "title": "Interest is a Price",
              "text": "Interest is the price a borrower pays for using someone else's money over time."
            },
            {
              "id": "r2",
              "title": "Principal is Base",
              "text": "The principal is the starting deposit or loan amount from which all calculations begin."
            },
            {
              "id": "r3",
              "title": "Compounding Accelerates",
              "text": "Compound interest adds each period's interest to the balance, accelerating wealth growth."
            },
            {
              "id": "r4",
              "title": "Time and Patience",
              "text": "Compounding requires uninterrupted reinvestment over time to reveal its true exponential power."
            },
            {
              "id": "r5",
              "title": "APR vs APY",
              "text": "Never compare raw APR to APY directly; compounding frequency changes the true effective yield."
            },
            {
              "id": "r6",
              "title": "The Rule of 72",
              "text": "Divide 72 by the annual percentage rate to quickly estimate the years needed to double money."
            },
            {
              "id": "r7",
              "title": "Inflation Erodes",
              "text": "Inflation reduces purchasing power, meaning cash balances can look larger while buying fewer goods."
            },
            {
              "id": "r8",
              "title": "Real Returns Rule",
              "text": "True financial progress is measured strictly by real returns after subtracting the rate of inflation."
            }
          ]
        },
